__pycache__/
# Тензоры обучения из ДЗ 4 — вне git: они версионируются в своём репозитории.
data/tokenized/
# Набор проверки версионируется DVC: сами jsonl вне git, указатели .dvc внутри.
# Каталог data/eval НЕ исключается целиком — иначе обход DVC не находит
# в нём стадии и `dvc pull` молча отвечает «everything is up to date».
/data/eval/*.jsonl
models/
metrics/
